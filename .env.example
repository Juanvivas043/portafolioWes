# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NO se versiona: nunca pongas credenciales aqui.

# --- Envio de correo (formulario de contacto) ---
# Con Gmail hay que usar una "contrasena de aplicacion", no la del correo:
# se genera en https://myaccount.google.com/apppasswords con la verificacion en
# dos pasos activada. Si se filtra, se revoca desde ahi sin tocar la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Buzon que recibe las solicitudes del formulario.
# Si se omite, se usa SMTP_USER.
CONTACT_TO_EMAIL=tucorreo@gmail.com
