.claude/settings.local.json

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# MEDIOS
# /public/media SI se versiona: los .webp y .webm optimizados son parte del
# repositorio y deben subirse. Solo se ignoran los originales sin optimizar
# que los scripts de /scripts consumen y luego convierten.
# ---------------------------------------------------------------------------
/public/media/**/*.jpg
/public/media/**/*.jpeg
/public/media/**/*.png
/public/media/**/*.heic
/public/media/**/*.tif
/public/media/**/*.tiff
/public/media/**/*.mov
/public/media/**/*.avi
/public/media/**/*.mkv

# Los .mp4 en crudo tambien son originales. La unica excepcion es el fallback
# del loop del Hero, que si forma parte del sitio publicado.
/public/media/**/*.mp4

# Basura de macOS que viaja al copiar desde un Mac (resource forks)
._*
/public/media/**/*.arw
/public/media/**/*.cr2
/public/media/**/*.dng

# >>> videos publicados (generado por scripts/select-published-videos.js)
# Los .webm no se versionan por defecto: la libreria completa pesa mas de lo
# que conviene en un repo. Solo suben los que el sitio publica.
/public/media/**/*.webm
# Recursos fijos de la interfaz (no son piezas del portafolio).
!/public/media/videos/sitio/*.webm
!/public/media/videos/conciertos/anima-sunrise.webm
!/public/media/videos/conciertos/def-anima-halloween.webm
